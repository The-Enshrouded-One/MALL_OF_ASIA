# Player builds (large; publish them as GitHub Release assets instead)
Unity Files/[Bb]uilds/
*.apk
*.aab

# ---------------------------------------------------------------- local tooling
# Locally installed Unity editor and installers
/.unity/
.unity-*-installer.exe
.unity-hub-installer.exe

# Stray Unity folders created when the repository root was opened as a Unity project
/Assets/
/Library/
/Logs/
/Packages/
/ProjectSettings/
/Temp/
/UserSettings/
/_tmp_UnityBuild_*/

# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
